# Copiar a .env y completar valores reales.
# .env está gitignored, este archivo (.env.example) sí se versiona.

# ── Telegram (notificaciones HITL) ────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Maps Geocoding (opcional, mejora calidad de direcciones) ───
# Sin esta key se cae a Nominatim (gratis pero rate-limited)
GOOGLE_API_KEY=

# ── carto.arba.gov.ar (solo si vas a usar consulta_arba.py) ───────────
# Cómo obtener JSESSIONID:
#   1. Iniciar sesión en https://carto.arba.gov.ar/cartoArba/
#   2. DevTools → Application → Cookies → JSESSIONID
CARTO_JSESSIONID=
CARTO_TOKEN=

# ── Anthropic (para el orquestador LLM, próxima iteración) ────────────
ANTHROPIC_API_KEY=
